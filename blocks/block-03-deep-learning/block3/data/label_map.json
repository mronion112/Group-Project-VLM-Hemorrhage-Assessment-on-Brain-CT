      },
      "exam_level_derivation_rule": "Examination duong tinh neu co bat ky lat nao co No_Hemorrhage == 0 (hoac bat ky subtype == 1).",
      "has_pixel_mask": true,
      "mask_type": "binary_ich_only",
      "mask_voxel_values_verified": [0, 254],
      "mask_binarization_rule": "(mask > 0).astype(uint8) -> {0, 1}",
