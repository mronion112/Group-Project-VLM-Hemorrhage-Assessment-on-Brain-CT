        "1": "EDH",
        "2": "IPH",
        "3": "IVH",
        "4": "SAH",
        "5": "SDH"
      },
      "raw_labels_in_dataset_json": {
        "0": "background",
        "1": "epidural",
        "2": "intraparenchymal",
        "3": "intraventricular",
        "4": "subarachnoid",
        "5": "subdural"
