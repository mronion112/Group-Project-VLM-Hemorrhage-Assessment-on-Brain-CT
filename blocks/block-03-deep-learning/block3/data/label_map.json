  "datasets": {
    "rsna_ich": {
      "label_granularity": "slice_2d",
      "raw_columns_or_keys": {
        "epidural": "EDH",
        "subdural": "SDH",
        "subarachnoid": "SAH",
        "intraparenchymal": "IPH",
        "intraventricular": "IVH",
        "any": "ICH_PRESENCE"
      },
      "exam_level_derivation_rule": "Mot examination (StudyInstanceUID) duoc gan nhan duong tinh (1) cho ICH hoac cho tung subtype neu va chi neu co it nhat 1 lat (slice) thuoc examination do co nhan = 1 trong stage_2_train.csv. Nhan muc lat (slice-level) duoc giu nguyen.",
      "has_pixel_mask": false,
