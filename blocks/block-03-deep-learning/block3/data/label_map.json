    "cq500": {
      "label_granularity": "exam_3d",
      "raw_columns_or_keys": {
        "ICH": "ICH_PRESENCE",
        "EDH": "EDH",
        "SDH": "SDH",
        "SAH": "SAH",
        "IPH": "IPH",
        "IVH": "IVH"
      },
      "exam_level_derivation_rule": "Mayority vote giua 3 bac si X-quang (R1, R2, R3) theo reads.csv cua CQ500.",
