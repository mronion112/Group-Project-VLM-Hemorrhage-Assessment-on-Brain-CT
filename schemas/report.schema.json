{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "language",
    "report_text",
    "claims",
    "unsupported_claims",
    "missing_evidence",
    "model_name",
    "model_version"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "partial", "failed"]},
    "language": {"type": "string", "minLength": 1},
    "report_text": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "evidence"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "value": {},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "unsupported_claims": {"type": "array", "items": {"type": ["string", "object"]}},
    "missing_evidence": {"type": "array", "items": {"type": ["string", "object"]}},
    "model_name": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "weights_hash": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "minLength": 1},
    "source_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": ["string", "object"]}},
    "errors": {"type": "array", "items": {"type": ["string", "object"]}}
  }
}
