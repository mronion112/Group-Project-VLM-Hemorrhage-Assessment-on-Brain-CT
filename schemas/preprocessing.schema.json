{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "preprocessing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "source_uri",
    "split_manifest_id",
    "partition",
    "output_artifact",
    "space_id",
    "hu_conversion",
    "resampling",
    "windows",
    "qc",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "partial", "failed"]},
    "source_uri": {"type": "string", "minLength": 1},
    "split_manifest_id": {"type": "string", "minLength": 1},
    "partition": {"enum": ["train", "validation", "test"]},
    "output_artifact": {"type": "string", "minLength": 1},
    "space_id": {"type": "string", "minLength": 1},
    "hu_conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "resampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "target_spacing_mm_xyz"],
      "properties": {
        "applied": {"type": "boolean"},
        "target_spacing_mm_xyz": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          ]
        }
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "wl", "ww"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "wl": {"type": "number"},
          "ww": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "diffusion_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "artifact", "model_version", "branch_status"],
      "properties": {
        "enabled": {"type": "boolean"},
        "artifact": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "branch_status": {"type": "string", "minLength": 1}
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_valid", "slice_order_valid", "intensity_status"],
      "properties": {
        "geometry_valid": {"type": "boolean"},
        "slice_order_valid": {"type": "boolean"},
        "intensity_status": {"type": "string", "minLength": 1}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "source_artifact_ids": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": ["string", "object"]}},
    "errors": {"type": "array", "items": {"type": ["string", "object"]}}
  }
}
